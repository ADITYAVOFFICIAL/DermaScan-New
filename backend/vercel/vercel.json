{
    "version": 2,
    "builds": [
      {
        "src": "./server.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/server.js"
      }
    ],
    "env": {
      "NODE_ENV": "production",
      "MONGO_URI": "@mongo_uri",
      "JWT_SECRET": "@jwt_secret",
      "FRONTEND_URL": "your_deployed_frontend_url",
      "BLOB_READ_WRITE_TOKEN": "@blob_read_write_token"
    }
  }